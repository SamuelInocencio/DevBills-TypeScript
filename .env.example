# Variáveis do docker-compose. Copie para .env e preencha.
#   cp .env.example .env

# ---------- Caddy ----------
# Local: deixe :80 (HTTP puro).
# VPS:   troque pelo domínio (ex.: devbills.com.br) e o Caddy emite o
#        certificado Let's Encrypt sozinho. Exige o DNS já apontando para a VPS.
SITE_ADDRESS=:80

# ---------- PostgreSQL ----------
POSTGRES_USER=devbills
POSTGRES_PASSWORD=
POSTGRES_DB=devbills

# ---------- Firebase Admin (backend) ----------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Entre aspas duplas, com \n literais.
FIREBASE_PRIVATE_KEY=""

# ---------- Firebase Web (frontend, injetado no build) ----------
# /api é o caminho servido pelo Caddy na mesma origem — não use localhost aqui.
VITE_API_URL=/api
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
